--- a/src/channel.rs
+++ b/src/channel.rs
@@ -34,6 +34,19 @@ pub const SERVICE_DISPLAY_NAME: &str = CHANNEL_IDENTITY.service_display_name;
 pub const MACOS_APP_BUNDLE_ID: &str = CHANNEL_IDENTITY.macos_app_bundle_id;
 pub const MACOS_SERVICE_ID: &str = CHANNEL_IDENTITY.macos_service_id;

+#[cfg(all(windows, feature = "development-channel"))]
+pub(crate) const NETVERGE_GUARDED_CORE_NAME: &str = "netverge-mihomo-service.exe";
+
+#[cfg(any(feature = "client", feature = "standalone"))]
+pub(crate) fn is_supported_core_name(name: &str) -> bool {
+    #[cfg(all(windows, feature = "development-channel"))]
+    if name == NETVERGE_GUARDED_CORE_NAME {
+        return true;
+    }
+
+    matches!(name.strip_suffix(std::env::consts::EXE_SUFFIX), Some("verge-mihomo" | "verge-mihomo-alpha"))
+}
